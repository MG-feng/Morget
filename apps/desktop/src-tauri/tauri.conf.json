{
  "productName": "Morget",
  "version": "0.1.0",
  "identifier": "com.morget.core",
  "build": {
    "beforeBuildCommand": "pnpm --filter morget-desktop build",
    "beforeDevCommand": "pnpm --filter morget-desktop dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      { "title": "Morget", "width": 1200, "height": 800, "minWidth": 900, "minHeight": 600, "resizable": true, "fullscreen": false, "decorations": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://images.workoscdn.com; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [ "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico" ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["morget"] }
    }
  },
  "productName": "Morget",
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://images.workoscdn.com; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    }
  },
  "permissions": [
    "core:default",
    "core:app:default",
    "store:default",
    "dialog:default",
    "opener:default",
    "deep-link:default",
    "fs:default"
  ]
}
